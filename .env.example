SUPABASE_URL=http://supabase-kong.supabase.svc.cluster.local:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Generate each of these with: openssl rand -base64 32
# scripts/check-no-secrets.mjs rejects anything shorter than 32 characters and
# rejects the "replace-me" placeholders below outright -- do not deploy with
# either value unchanged.
QWIXX_COOKIE_SECRET=replace-me-with-a-real-32-byte-base64-secret
QWIXX_IP_HASH_SECRET=replace-me-with-a-real-32-byte-base64-secret
