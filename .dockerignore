# Keep the build context (and the image) to what the app needs at run time.
.git
.gitignore
.github
.dockerignore
Dockerfile

# Python / tooling
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
tests/
pytest.ini
requirements-dev.txt

# Notebooks, docs, database proposal
*.ipynb
.ipynb_checkpoints/
README.md
supabase/

# Secrets and local config must never enter an image
.env
.env.*
.streamlit/secrets.toml

# OS / editor
.DS_Store
.idea/
.vscode/
